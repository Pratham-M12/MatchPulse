# Copy this file to .env and fill in your own values. Never commit .env itself.

# Free key from https://dashboard.api-football.com (Free plan: 100 requests/day).
# Must be prefixed with EXPO_PUBLIC_ to be readable in the app at runtime.
EXPO_PUBLIC_API_FOOTBALL_KEY=

# Public URL of the deployed MatchPulse GNews proxy (services/news-proxy/).
# Example: https://matchpulse-news-proxy.<your-account>.workers.dev
# Leave blank to disable football news (the app will show a neutral placeholder).
EXPO_PUBLIC_NEWS_PROXY_URL=
